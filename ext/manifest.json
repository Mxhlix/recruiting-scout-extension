{
  "manifest_version": 3,
  "name": "スカウト送信の補助",
  "version": "0.1.0",
  "description": "候補者の職務経歴書を読み、AIが送り先と文面の案を作ります。送信は担当者が確かめて押します。",
  "action": {
    "default_title": "スカウト送信の補助",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://localhost:8974/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    { "matches": ["http://localhost:8974/*"], "js": ["site.js", "content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["panel.html"], "matches": ["http://localhost:8974/*"] }
  ]
}
